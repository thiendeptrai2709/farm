      m_Items: []
  - m_Id: 9427
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 9426
    m_Localized: "Tho\xE1t k\u1EB9t"
    m_Metadata:
      m_Items: []
  - m_Id: 9428
    m_Localized: "H\u1EE7y"
    m_Metadata:
      m_Items: []
  - m_Id: 9429
    m_Localized: "B\u1EA1n kh\xF4ng c\xF3 nhi\u1EC7m v\u1EE5 n\xE0o"
    m_Metadata:
      m_Items: []
  - m_Id: 9430
    m_Localized: "--- NHI\u1EC6M V\u1EE4 \u0110ANG L\xC0M ---"
    m_Metadata:
      m_Items: []
  - m_Id: 9431
    m_Localized: "Ti\u1EBFn \u0111\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 9432
    m_Localized: "Y\xEAu c\u1EA7u:"
    m_Metadata:
      m_Items: []
  - m_Id: 9433
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng:"
    m_Metadata:
      m_Items: []
  - m_Id: 9434
    m_Localized: "V\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 9435
    m_Localized: "Ch\u1EC9 c\u1EA7n n\xF3i chuy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 9436
    m_Localized: "Ki\u1EC7t s\u1EE9c"
    m_Metadata:
      m_Items: []
  - m_Id: 9437
    m_Localized: "Kh\xF4ng \u0111\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 9438
    m_Localized: "B\u1EA1n c\xF3 ch\u1EAFc mu\u1ED1n v\u1EE9t b\u1ECF v\u1EADt ph\u1EA9m
      n\xE0y?"
    m_Metadata:
      m_Items: []
  - m_Id: 9439
    m_Localized: "Nh\u1EA5n \u0111\u1EC3 \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 9440
    m_Localized: "[B] M\u1EDF menu"
    m_Metadata:
      m_Items: []
  - m_Id: 9441
    m_Localized: "[E] Xem l\u1ECBch tr\xECnh Xe Bus"
    m_Metadata:
      m_Items: []
  - m_Id: 9442
    m_Localized: "[E] M\u1EDF r\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 9443
    m_Localized: "[E] Ngh\u1EC9 ng\u01A1i tr\xEAn gi\u01B0\u1EDDng"
    m_Metadata:
      m_Items: []
  - m_Id: 9444
    m_Localized: "[E] M\u1EDF x\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 9445
    m_Localized: "Khu v\u1EF1c C\xE2u c\xE1 (C\u1EA7n c\u1EA7m C\u1EA7n C\xE2u)"
    m_Metadata:
      m_Items: []
  - m_Id: 9446
    m_Localized: "[E] Qu\u0103ng c\u1EA7n"
    m_Metadata:
      m_Items: []
  - m_Id: 9447
    m_Localized: "[E] H\u1EE7y c\xE2u"
    m_Metadata:
      m_Items: []
  - m_Id: 9448
    m_Localized: "HI\u1EC6P"
    m_Metadata:
      m_Items: []
  - m_Id: 9449
    m_Localized: "Chu\u1EA9n b\u1ECB hi\u1EC7p"
    m_Metadata:
      m_Items: []
  - m_Id: 9450
    m_Localized: "T\xFAi \u0111\u1ED3 \u0111\xE3 \u0111\u1EA7y"
    m_Metadata:
      m_Items: []
  - m_Id: 9451
    m_Localized: "[E] X\u1EDBi \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 9452
    m_Localized: "[E] Gieo h\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 9454
    m_Localized: "[E] Xem Th\xF4ng B\xE1o Ch\u1EE3"
    m_Metadata:
      m_Items: []
  - m_Id: 9455
    m_Localized: "G\u1EA5u \u0111ang ng\u1EE7, h\xE3y c\u1EA7m g\xEC \u0111\xF3 cho
      n\xF3 \u0103n..."
    m_Metadata:
      m_Items: []
  - m_Id: 9456
    m_Localized: "M\xF3n n\xE0y g\u1EA5u kh\xF4ng \u0103n \u0111\u01B0\u1EE3c..."
    m_Metadata:
      m_Items: []
  - m_Id: 9457
    m_Localized: "[E] Cho g\u1EA5u \u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 9458
    m_Localized: "Gi\u1EDD"
    m_Metadata:
      m_Items: []
  - m_Id: 9459
    m_Localized: "[E] Gieo h\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 9460
    m_Localized: "[E] T\u01B0\u1EDBi n\u01B0\u1EDBc"
    m_Metadata:
      m_Items: []
  - m_Id: 9461
    m_Localized: "[E] B\xF3n ph\xE2n"
    m_Metadata:
      m_Items: []
  - m_Id: 9462
    m_Localized: "\u0110ang ph\xE1t tri\u1EC3n..."
    m_Metadata:
      m_Items: []
  - m_Id: 9463
    m_Localized: "[E] Thu ho\u1EA1ch"
    m_Metadata:
      m_Items: []
  - m_Id: 9464
    m_Localized: "[E] X\xF3a \xF4 \u0111\u1EA5t"
    m_Metadata:
      m_Items: []
  - m_Id: 9465
    m_Localized: "[E] Ch\u1EB7t c\xE2y con"
    m_Metadata:
      m_Items: []
